# Optional. Without a key, the app uses built-in rule-based answers.
# Set ONE of these (both use the OpenAI-compatible API):

# xAI Grok: https://console.x.ai  (paid API; new accounts sometimes get promo credits)
XAI_API_KEY=

# Groq: https://console.groq.com  (free tier, runs open models like Llama)
GROQ_API_KEY=

# Optional: force a specific model id (otherwise a good one is picked automatically)
AI_MODEL=
