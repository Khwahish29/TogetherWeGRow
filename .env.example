# ---- Database -------------------------------------------------------------
# Production: a Postgres connection string. On Vercel, add a Postgres database from the Storage tab
# (Neon) and this is set for you. Use the POOLED connection string.
# Local development: leave empty and a local Postgres (PGlite) is created in ./.data
DATABASE_URL=

# ---- Guidance (suggested skills, plain-language explanations, step-by-step help) ----
# Optional. Without a key, the site uses built-in rule-based answers.
# Groq: https://console.groq.com  (free tier)
GROQ_API_KEY=
# xAI Grok: https://console.x.ai
XAI_API_KEY=
# Optional: force a specific model id
AI_MODEL=

# ---- Email (optional) -------------------------------------------------------
# Password-reset links and "you have a new message" alerts, sent through https://resend.com
# Without these the site works, but "Forgot your password?" can't send a link.
RESEND_API_KEY=
EMAIL_FROM=
# The public address of the site, used in emails (for example https://togetherwegrow.org)
SITE_URL=
